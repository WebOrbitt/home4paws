NODE_ENV=development
PORT=4000
FRONTEND_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# Local SQLite file. Its directory is created when you run the migration.
DB_FILE=./.runtime/home4paws.sqlite

JWT_ACCESS_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_ACCESS_TTL=15m
REFRESH_TOKEN_DAYS=14

ADMIN_NAME=Home4Paws Admin
ADMIN_EMAIL=admin@home4paws.local
ADMIN_PASSWORD=replace-with-a-unique-admin-password

UPLOAD_DIRECTORY=./uploads
MAX_UPLOAD_MB=10

# Optional for local development. When configured, new image/document uploads use Cloudinary.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
